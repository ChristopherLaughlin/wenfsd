# ---- wenFSD backend config ----
# Copy to `.env` and fill in. NEVER commit the real .env.

# Server
PORT=8787
PUBLIC_BASE_URL=https://wenfsd.com        # your domain (used for OAuth redirect + Tesla partner registration)
SESSION_SECRET=change-me-to-a-long-random-string

# MOCK_MODE=true lets you run the whole stack with seed data and NO Tesla credentials,
# so you can build/deploy before Tesla approves your Fleet API access. Set to false for real.
MOCK_MODE=true

# ---- Tesla Fleet API (developer.tesla.com) ----
# Create an app at https://developer.tesla.com, then paste credentials here.
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
# Scopes we request from the owner. Read-only is enough for version tracking.
TESLA_SCOPES=openid offline_access vehicle_device_data
# OAuth redirect — must EXACTLY match what you register in the Tesla dev portal:
TESLA_REDIRECT_URI=https://wenfsd.com/auth/callback
# Fleet API region base URL. AU/APAC + NA share the NA host; EU uses the eu host.
#   NA/APAC: https://fleet-api.prod.na.vn.cloud.tesla.com
#   EU:      https://fleet-api.prod.eu.vn.cloud.tesla.com
TESLA_FLEET_BASE=https://fleet-api.prod.na.vn.cloud.tesla.com
TESLA_AUTH_BASE=https://auth.tesla.com
# Audience for partner/client-credentials token (same as the fleet base host):
TESLA_AUDIENCE=https://fleet-api.prod.na.vn.cloud.tesla.com

# Path to the EC private key whose PUBLIC half you host at
# https://wenfsd.com/.well-known/appspecific/com.tesla.3p.public-key.pem
# Generate with:  openssl ecparam -name prime256v1 -genkey -noout -out keys/private-key.pem
TESLA_PRIVATE_KEY_PATH=keys/private-key.pem

# ---- Database ----
# Railway/Render give you this automatically when you add a Postgres plugin.
DATABASE_URL=postgres://user:pass@localhost:5432/wenfsd

# How often to poll each linked vehicle for its software version (cron expression).
POLL_CRON=*/30 * * * *
